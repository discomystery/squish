{
  "name": "squish",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local image/video/GIF compressor and converter",
  "scripts": {
    "start": "node server.js",
    "vendor": "rm -rf public/vendor/ffmpeg && mkdir -p public/vendor/ffmpeg && cp node_modules/@ffmpeg/ffmpeg/dist/esm/*.js public/vendor/ffmpeg/"
  },
  "dependencies": {
    "express": "^4.22.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2"
  }
}
